# ==================================================
# Purita's Beauty Lounge — Laravel Gitignore
# ==================================================

# Laravel application environment (NEVER commit this)
laravel/.env
laravel/.env.backup
laravel/.env.production
.env

# Laravel generated & runtime files
laravel/vendor/
laravel/node_modules/
laravel/public/hot
laravel/public/storage
laravel/storage/*.key
laravel/storage/app/public
laravel/storage/framework/cache/
laravel/storage/framework/sessions/
laravel/storage/framework/views/
laravel/storage/logs/
laravel/bootstrap/cache/*.php

# Vite / Build output
laravel/public/build/

# PHPUnit cache
laravel/.phpunit.result.cache

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Logs
*.log
logs/
